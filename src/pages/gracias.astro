---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="¡Gracias! | Innovate for Impact" description="Tu registro ha sido recibido correctamente.">
	<section class="thank-you">
		<div class="container">
			<span class="icon" aria-hidden="true">✓</span>
			<h1>¡Gracias por registrarte!</h1>
			<p>
				Hemos recibido tu información. Te contactaremos pronto con novedades sobre próximos
				eventos y oportunidades de participación en Innovate for Impact.
			</p>
			<div class="actions">
				<a href="/" class="btn primary">Volver al inicio</a>
				<a href="/eventos/new-york-2025/" class="btn ghost">Ver próximo evento</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.thank-you {
		padding-block: 8rem 6rem;
		text-align: center;
		background:
			radial-gradient(50rem 26rem at 80% -10%, color-mix(in srgb, var(--color-lime) 20%, transparent), transparent);
	}

	.icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 5rem;
		height: 5rem;
		font-size: 2rem;
		color: var(--color-forest);
		background-color: var(--color-lime);
		border-radius: 50%;
		margin-bottom: 2rem;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		color: var(--color-forest);
		margin-bottom: 1.25rem;
	}

	p {
		max-width: 48ch;
		margin-inline: auto;
		font-size: 1.1rem;
		opacity: 0.8;
		margin-bottom: 3rem;
	}

	.actions {
		display: flex;
		justify-content: center;
		gap: 1rem;
	}

	.btn {
		padding: 0.9rem 1.9rem;
		border-radius: 999px;
		font-weight: 600;
		font-size: 1rem;
		transition: transform 0.2s ease, background-color 0.2s ease;
	}

	.primary {
		background-color: var(--color-forest);
		color: var(--color-lime);
	}

	.primary:hover {
		transform: translateY(-2px);
		background-color: var(--color-moss);
	}

	.ghost {
		border: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
	}

	.ghost:hover {
		transform: translateY(-2px);
		border-color: var(--color-forest);
		color: var(--color-moss);
	}
</style>
