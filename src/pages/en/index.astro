---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import EventCard from '../../components/EventCard.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('eventos', ({ data }) => data.lang === 'en');
const sorted = [...events].sort((a, b) => a.data.order - b.data.order);
const upcoming = sorted.filter((e) => e.data.status !== 'past');
const past = sorted.filter((e) => e.data.status === 'past');
const testimonials = await getCollection('testimonios', ({ data }) => data.lang === 'en');

const stats = [
	{ value: '2,200+', label: 'registrations' },
	{ value: '50', label: 'speakers' },
	{ value: '11', label: 'panels' },
	{ value: '7', label: 'strategic partnerships' },
];

const attendees = [
	'Apple',
	'AT&T',
	'Google',
	'Deloitte',
	'UNICEF',
	'Amazon',
	'Accenture',
	'Salesforce',
	'HSBC',
	'Sephora',
	'JetBlue',
];

const experiences = [
	{
		title: 'Concerts with purpose',
		description: 'Live music that connects minds and hearts with the cause.',
		variant: 'concert',
	},
	{
		title: 'Immersive soundbath',
		description: 'Sensory experiences to absorb the ideas from the stage.',
		variant: 'soundbath',
	},
	{
		title: 'Strategic connections',
		description: 'Networking spaces where real partnerships are born.',
		variant: 'networking',
	},
];

const sponsors = ['Asuaire', 'Algoryt', 'Connecto', 'T+C', 'Overview Effect'];
---

<BaseLayout title="Innovate for Impact | Where innovation meets impact" description="Global initiative bringing together leaders, companies and changemakers through meaningful conversations and immersive experiences." locale="en">
	<section class="hero">
		<div class="container hero-inner">
			<p class="eyebrow">Climate Week · New York · September 2025</p>
			<h1>
				Where <em>innovation</em> meets <em>impact</em>
			</h1>
			<p class="lede">
				Innovate for Impact is a global initiative that brings together leaders, companies and
				changemakers through meaningful conversations, immersive experiences and strategic
				partnerships.
			</p>
			<div class="actions">
				<a href="/en#eventos" class="btn primary">View upcoming events</a>
				<a href="/registro" class="btn ghost">Join the community</a>
			</div>

			<dl class="stats">
				{
					stats.map((stat) => (
						<div class="stat">
							<dt>{stat.value}</dt>
							<dd>{stat.label}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="attendees" aria-label="Some of our attendees">
		<p class="container marquee-title">Some of our attendees</p>
		<div class="marquee">
			<div class="marquee-track">
				{
					[...attendees, ...attendees].map((name) => (
						<span class="attendee">{name}</span>
					))
				}
			</div>
		</div>
	</section>

	<section id="nosotros" class="about">
		<div class="container">
			<SectionHeader
				eyebrow="What is IFI?"
				title="A global platform where sustainability drives real action"
			/>
			<p class="about-text">
				Launched during <strong>Climate Week in New York</strong> and later expanded to
				Singapore, IFI unites leaders, companies and changemakers through meaningful
				conversations. In just three editions it has created a powerful platform where innovation
				inspires real change, with a local approach to global sustainability challenges.
			</p>
		</div>
	</section>

	<section id="eventos" class="events">
		<div class="container">
			<SectionHeader eyebrow="2025 Agenda" title="Upcoming flagship events" />
			<div class="card-grid">
				{
					upcoming.map((event) => (
						<EventCard {...event.data} href={`/en/events/${event.id.split('/')[1]}/`} />
					))
				}
			</div>
		</div>
	</section>

	<section id="experiencias" class="experiences">
		<div class="container">
			<SectionHeader
				eyebrow="Beyond talks"
				title="Ideas, music and unforgettable experiences"
				description="Our events blend inspiring talks with unique concerts, where innovation, nature and music come together."
			/>
			<div class="experience-grid">
				{
					experiences.map((exp) => (
						<figure class:list={['tile', exp.variant]}>
							<div class="art" />
							<figcaption>
								<h3>{exp.title}</h3>
								<p>{exp.description}</p>
							</figcaption>
						</figure>
					))
				}
			</div>
		</div>
	</section>

	<section id="comunidad" class="community">
		<div class="container">
			<SectionHeader
				eyebrow="Community"
				title="Past events"
				description="From exclusive dinners to collaborative activities: each edition leaves a stronger community of changemakers."
			/>
			<div class="card-grid two">
				{
					past.map((event) => (
						<EventCard {...event.data} href={`/en/events/${event.id.split('/')[1]}/`} />
					))
				}
			</div>
		</div>
	</section>

	<section class="testimonials">
		<div class="container">
			{testimonials.map((entry) => <TestimonialCard {...entry.data} />)}
		</div>
	</section>

	<section id="sponsors" class="sponsors">
		<div class="container">
			<SectionHeader eyebrow="Partners" title="Some of our sponsors" />
			<ul class="sponsor-list">
				{sponsors.map((name) => (
					<li>{name}</li>
				))}
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		padding-block: 7rem 5rem;
		background:
			radial-gradient(60rem 30rem at 85% -10%, color-mix(in srgb, var(--color-lime) 25%, transparent), transparent),
			radial-gradient(40rem 24rem at -10% 110%, color-mix(in srgb, var(--color-moss) 18%, transparent), transparent);
	}

	.hero-inner {
		max-width: 46rem;
	}

	.eyebrow {
		display: inline-block;
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-moss);
		border: 1px solid color-mix(in srgb, var(--color-moss) 35%, transparent);
		border-radius: 999px;
		padding: 0.4rem 1rem;
		margin-bottom: 1.75rem;
	}

	h1 {
		font-size: clamp(2.6rem, 6vw, 4.5rem);
		color: var(--color-forest);
		margin-bottom: 1.5rem;
	}

	h1 em {
		font-style: italic;
		font-weight: 400;
		color: var(--color-moss);
	}

	.lede {
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		max-width: 56ch;
		opacity: 0.8;
		margin-bottom: 2.5rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 4rem;
	}

	.btn {
		padding: 0.9rem 1.9rem;
		border-radius: 999px;
		font-weight: 600;
		font-size: 1rem;
		transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
	}

	.primary {
		background-color: var(--color-forest);
		color: var(--color-lime);
	}

	.primary:hover {
		transform: translateY(-2px);
		background-color: var(--color-moss);
	}

	.ghost {
		border: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
	}

	.ghost:hover {
		transform: translateY(-2px);
		border-color: var(--color-forest);
		color: var(--color-moss);
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5rem;
		border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
		padding-top: 2.5rem;
	}

	.stat dt {
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
		font-weight: 700;
		color: var(--color-forest);
		line-height: 1.2;
	}

	.stat dd {
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		opacity: 0.65;
	}

	.attendees {
		padding-block: 3rem;
		border-block: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
	}

	.marquee-title {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		opacity: 0.55;
		margin-bottom: 1.5rem;
	}

	.marquee {
		overflow: hidden;
		mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
	}

	.marquee-track {
		display: flex;
		align-items: center;
		gap: 3.5rem;
		width: max-content;
		animation: scroll 32s linear infinite;
	}

	.marquee:hover .marquee-track {
		animation-play-state: paused;
	}

	@keyframes scroll {
		to {
			transform: translateX(-50%);
		}
	}

	.attendee {
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 600;
		white-space: nowrap;
		color: color-mix(in srgb, var(--color-ink) 45%, transparent);
		transition: color 0.2s ease;
	}

	.attendee:hover {
		color: var(--color-forest);
	}

	.about {
		padding-block: 6rem 0;
	}

	.about-text {
		max-width: 62ch;
		margin-inline: auto;
		text-align: center;
		font-size: clamp(1rem, 2vw, 1.15rem);
		opacity: 0.85;
	}

	.events,
	.experiences,
	.community,
	.testimonials,
	.sponsors {
		padding-top: 6rem;
	}

	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.5rem;
		max-width: 62rem;
		margin-inline: auto;
	}

	.card-grid.two {
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		max-width: 52rem;
	}

	.experience-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.tile {
		border-radius: 1.5rem;
		overflow: hidden;
		background-color: #fff;
		box-shadow: 0 10px 30px color-mix(in srgb, var(--color-ink) 8%, transparent);
		transition: transform 0.25s ease;
	}

	.tile:hover {
		transform: translateY(-4px);
	}

	.art {
		height: 220px;
	}

	.concert .art {
		background:
			radial-gradient(120% 120% at 20% 20%, #c8f169 0%, transparent 55%),
			linear-gradient(135deg, #12332b 0%, #2d5a4a 100%);
	}

	.soundbath .art {
		background:
			radial-gradient(circle at 70% 30%, #f6f3ec33 0%, transparent 45%),
			repeating-radial-gradient(circle at 50% 50%, #12332b 0px, #2d5a4a 8px, #12332b 16px);
	}

	.networking .art {
		background:
			radial-gradient(100% 100% at 80% 90%, #c8f16944 0%, transparent 60%),
			linear-gradient(315deg, #1c2420 0%, #2d5a4a 100%);
	}

	figcaption {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	figcaption h3 {
		font-size: 1.25rem;
		color: var(--color-forest);
	}

	figcaption p {
		font-size: 0.95rem;
		opacity: 0.75;
	}

	.sponsor-list {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		max-width: 46rem;
		margin-inline: auto;
	}

	.sponsor-list li {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.05rem;
		color: var(--color-moss);
		border: 1px solid color-mix(in srgb, var(--color-moss) 30%, transparent);
		border-radius: 999px;
		padding: 0.6rem 1.6rem;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.sponsor-list li:hover {
		background-color: var(--color-forest);
		color: var(--color-lime);
		border-color: var(--color-forest);
	}

	@media (max-width: 720px) {
		.hero {
			padding-block: 4.5rem 3.5rem;
		}

		.stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.events,
		.experiences,
		.community,
		.testimonials,
		.sponsors {
			padding-top: 4.5rem;
		}
	}
</style>
