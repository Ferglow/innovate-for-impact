---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const events = await getCollection('eventos', ({ data }) => data.lang === 'en');
	return events.map((event) => ({
		params: { slug: event.id.split('/')[1] },
		props: { event },
	}));
}

const { event } = Astro.props;
const { Content } = await render(event);

const statusLabels = {
	next: 'Recent event',
	soon: 'Coming soon',
	past: 'Past event',
} as const;
---

<BaseLayout title={`${event.data.city} | Innovate for Impact`} description={event.data.kicker}>
	<article>
		<header class="hero">
			<div class="container">
				<a href="/en" class="back">← Back to events</a>
				<p class="badge">{statusLabels[event.data.status]}</p>
				{event.data.kicker && <p class="kicker">{event.data.kicker}</p>}
				<h1>{event.data.city}</h1>
				<p class="meta">{event.data.country} · {event.data.date}</p>

				{
					event.data.stats && (
						<dl class="stats">
							{event.data.stats.map((stat) => (
								<div>
									<dt>{stat.value}</dt>
									<dd>{stat.label}</dd>
								</div>
							))}
						</dl>
					)
				}
			</div>
		</header>

		<div class="container body">
			<div class="prose">
				<Content />
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.hero {
		background:
			radial-gradient(50rem 26rem at 90% -20%, color-mix(in srgb, var(--color-lime) 22%, transparent), transparent),
			var(--color-forest);
		color: var(--color-cream);
		padding-block: 6rem 4.5rem;
	}

	.back {
		display: inline-block;
		font-size: 0.9rem;
		opacity: 0.7;
		margin-bottom: 3rem;
		transition: opacity 0.2s ease;
	}

	.back:hover {
		opacity: 1;
	}

	.badge {
		display: inline-block;
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-forest);
		background-color: var(--color-lime);
		border-radius: 999px;
		padding: 0.35rem 0.9rem;
		margin-bottom: 1.25rem;
	}

	.kicker {
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-lime);
		margin-bottom: 0.5rem;
	}

	h1 {
		font-size: clamp(2.8rem, 7vw, 5rem);
		margin-bottom: 0.75rem;
	}

	.meta {
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		opacity: 0.7;
	}

	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 2.5rem;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid color-mix(in srgb, var(--color-cream) 20%, transparent);
	}

	.stats dt {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 700;
		color: var(--color-lime);
		line-height: 1.2;
	}

	.stats dd {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		opacity: 0.7;
	}

	.body {
		padding-block: 4rem;
	}

	.prose {
		max-width: 46rem;
		margin-inline: auto;
	}

	.prose :global(h2) {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		color: var(--color-forest);
		margin-top: 3rem;
		margin-bottom: 1rem;
	}

	.prose :global(h3) {
		font-size: 1.35rem;
		color: var(--color-forest);
		margin-top: 2.25rem;
		margin-bottom: 0.75rem;
	}

	.prose :global(p) {
		font-size: 1.05rem;
		line-height: 1.8;
		opacity: 0.85;
		margin-bottom: 1.25rem;
	}

	.prose :global(ul) {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}

	.prose :global(li) {
		position: relative;
		padding-left: 1.75rem;
		opacity: 0.85;
	}

	.prose :global(li)::before {
		content: '●';
		position: absolute;
		left: 0;
		color: var(--color-moss);
		font-size: 0.7rem;
		top: 0.45em;
	}

	@media (max-width: 720px) {
		.hero {
			padding-block: 4rem 3.5rem;
		}
	}
</style>
