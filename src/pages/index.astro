---
import BaseLayout from '../layouts/BaseLayout.astro';

const stats = [
	{ value: '2,200+', label: 'registros' },
	{ value: '50', label: 'speakers' },
	{ value: '11', label: 'paneles' },
	{ value: '7', label: 'alianzas estratégicas' },
];

const attendees = [
	'Apple',
	'AT&T',
	'Google',
	'Deloitte',
	'UNICEF',
	'Amazon',
	'Accenture',
	'Salesforce',
	'HSBC',
	'Sephora',
	'JetBlue',
];
---

<BaseLayout title="Innovate for Impact | Donde la innovación se encuentra con el impacto">
	<section class="hero">
		<div class="container hero-inner">
			<p class="eyebrow">Climate Week · Nueva York · Septiembre 2025</p>
			<h1>
				Donde la <em>innovación</em> se encuentra con el <em>impacto</em>
			</h1>
			<p class="lede">
				Innovate for Impact es una iniciativa global que reúne a líderes, empresas y changemakers
				mediante conversaciones significativas, experiencias inmersivas y alianzas estratégicas.
			</p>
			<div class="actions">
				<a href="#eventos" class="btn primary">Ver próximos eventos</a>
				<a href="#comunidad" class="btn ghost">Únete a la comunidad</a>
			</div>

			<dl class="stats">
				{
					stats.map((stat) => (
						<div class="stat">
							<dt>{stat.value}</dt>
							<dd>{stat.label}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="attendees" aria-label="Algunos de nuestros asistentes">
		<p class="container marquee-title">Algunos de nuestros asistentes</p>
		<div class="marquee">
			<div class="marquee-track">
				{
					[...attendees, ...attendees].map((name) => (
						<span class="attendee">{name}</span>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		padding-block: 7rem 5rem;
		background:
			radial-gradient(60rem 30rem at 85% -10%, color-mix(in srgb, var(--color-lime) 25%, transparent), transparent),
			radial-gradient(40rem 24rem at -10% 110%, color-mix(in srgb, var(--color-moss) 18%, transparent), transparent);
	}

	.hero-inner {
		max-width: 46rem;
	}

	.eyebrow {
		display: inline-block;
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-moss);
		border: 1px solid color-mix(in srgb, var(--color-moss) 35%, transparent);
		border-radius: 999px;
		padding: 0.4rem 1rem;
		margin-bottom: 1.75rem;
	}

	h1 {
		font-size: clamp(2.6rem, 6vw, 4.5rem);
		color: var(--color-forest);
		margin-bottom: 1.5rem;
	}

	h1 em {
		font-style: italic;
		font-weight: 400;
		color: var(--color-moss);
	}

	.lede {
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		max-width: 56ch;
		opacity: 0.8;
		margin-bottom: 2.5rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 4rem;
	}

	.btn {
		padding: 0.9rem 1.9rem;
		border-radius: 999px;
		font-weight: 600;
		font-size: 1rem;
		transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
	}

	.primary {
		background-color: var(--color-forest);
		color: var(--color-lime);
	}

	.primary:hover {
		transform: translateY(-2px);
		background-color: var(--color-moss);
	}

	.ghost {
		border: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
	}

	.ghost:hover {
		transform: translateY(-2px);
		border-color: var(--color-forest);
		color: var(--color-moss);
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5rem;
		border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
		padding-top: 2.5rem;
	}

	.stat dt {
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
		font-weight: 700;
		color: var(--color-forest);
		line-height: 1.2;
	}

	.stat dd {
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		opacity: 0.65;
	}

	.attendees {
		padding-block: 3rem;
		border-block: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
	}

	.marquee-title {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		opacity: 0.55;
		margin-bottom: 1.5rem;
	}

	.marquee {
		overflow: hidden;
		mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
	}

	.marquee-track {
		display: flex;
		align-items: center;
		gap: 3.5rem;
		width: max-content;
		animation: scroll 32s linear infinite;
	}

	.marquee:hover .marquee-track {
		animation-play-state: paused;
	}

	@keyframes scroll {
		to {
			transform: translateX(-50%);
		}
	}

	.attendee {
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 600;
		white-space: nowrap;
		color: color-mix(in srgb, var(--color-ink) 45%, transparent);
		transition: color 0.2s ease;
	}

	.attendee:hover {
		color: var(--color-forest);
	}

	@media (max-width: 720px) {
		.hero {
			padding-block: 4.5rem 3.5rem;
		}

		.stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
